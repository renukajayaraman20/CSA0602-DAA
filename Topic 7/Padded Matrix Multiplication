def add(A,B):
    return [[A[i][j]+B[i][j] for j in range(len(A))]
            for i in range(len(A))]

def sub(A,B):
    return [[A[i][j]-B[i][j] for j in range(len(A))]
            for i in range(len(A))]

def strassen(A,B):
    n=len(A)

    if n==1:
        return [[A[0][0]*B[0][0]]]

    m=n//2

    a=[r[:m] for r in A[:m]]
    b=[r[m:] for r in A[:m]]
    c=[r[:m] for r in A[m:]]
    d=[r[m:] for r in A[m:]]

    e=[r[:m] for r in B[:m]]
    f=[r[m:] for r in B[:m]]
    g=[r[:m] for r in B[m:]]
    h=[r[m:] for r in B[m:]]

    M1=strassen(add(a,d),add(e,h))
    M2=strassen(add(c,d),e)
    M3=strassen(a,sub(f,h))
    M4=strassen(d,sub(g,e))
    M5=strassen(add(a,b),h)
    M6=strassen(sub(c,a),add(e,f))
    M7=strassen(sub(b,d),add(g,h))

    C11=add(sub(add(M1,M4),M5),M7)
    C12=add(M3,M5)
    C21=add(M2,M4)
    C22=add(sub(add(M1,M3),M2),M6)

    return [C11[i]+C12[i] for i in range(m)] + \
           [C21[i]+C22[i] for i in range(m)]


def pad(A,n):
    return ([row+[0]*(n-len(row)) for row in A] +
            [[0]*n for _ in range(n-len(A))])


def strassen_padded(A,B):
    rows=len(A)
    cols=len(B[0])

    size=max(len(A),len(A[0]),len(B),len(B[0]))

    n=1
    while n<size:
        n*=2

    A=pad(A,n)
    B=pad(B,n)

    C=strassen(A,B)

    return [row[:cols] for row in C[:rows]]


