def strassen_hybrid(A,B,threshold=2):
    n=len(A)
    if n<=threshold:
        return standard_multiply(A,B)
    m=n//2
    a,b,c,d=[x[:m] for x in A[:m]],[x[m:] for x in A[:m]],[x[:m] for x in A[m:]],[x[m:] for x in A[m:]]
    e,f,g,h=[x[:m] for x in B[:m]],[x[m:] for x in B[:m]],[x[:m] for x in B[m:]]
    M1=strassen_hybrid(add(a,c),add(e,f),threshold)
    M2=strassen_hybrid(add(b,d),add(g,h),threshold)
    M3=strassen_hybrid(a,sub(f,h),threshold)
    M4=strassen_hybrid(d,sub(g,e),threshold)
    M5=strassen_hybrid(add(a,b),h,threshold)
    M6=strassen_hybrid(sub(c,a),add(e,f),threshold)
    M7=strassen_hybrid(sub(b,d),add(g,h),threshold)
    C11=add(sub(add(M1,M2),M5),M4)
    C12=add(M3,M5); C21=add(M4,M6)
    C22=add(sub(add(M1,M2),M3),M7)
    return [C11[i]+C12[i] for i in range(m)]+[C21[i]+C22[i] for i in range(m)]