def merge_sort(arr):

    if len(arr) <= 1:
        return arr, 0

    mid = len(arr) // 2

    left, c1 = merge_sort(arr[:mid])
    right, c2 = merge_sort(arr[mid:])

    result = []
    i = 0
    j = 0
    comparisons = 0

    while i < len(left) and j < len(right):

        comparisons += 1

        if left[i] <= right[j]:
            result.append(left[i])
            i += 1
        else:
            result.append(right[j])
            j += 1

    result.extend(left[i:])
    result.extend(right[j:])

    return result, comparisons + c1 + c2


quick_comparisons = 0


def quick_sort(arr, low, high):

    global quick_comparisons

    if low < high:

        pivot = arr[high]
        i = low - 1

        for j in range(low, high):

            quick_comparisons += 1

            if arr[j] <= pivot:
                i += 1
                arr[i], arr[j] = arr[j], arr[i]

        arr[i + 1], arr[high] = arr[high], arr[i + 1]

        p = i + 1

        quick_sort(arr, low, p - 1)
        quick_sort(arr, p + 1, high)


n = int(input("Enter number of elements: "))
arr = list(map(int, input("Enter elements: ").split()))

_, merge_comparisons = merge_sort(arr.copy())

quick_arr = arr.copy()
quick_sort(quick_arr, 0, n - 1)

print("Input Size | Merge Comparisons | Quick Comparisons")
print(n, "        |", merge_comparisons, "              |", quick_comparisons)